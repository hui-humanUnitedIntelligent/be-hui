{
  "appId": "com.behui.app",
  "appName": "HUI",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false,
    "path": "android",
    "buildOptions": {
      "keystorePath": "android/app/release.keystore",
      "keystoreAlias": "hui"
    }
  },
  "plugins": {
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    },
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "updateUrl": "https://be-hui.vercel.app/app-version.json",
      "autoUpdate": true,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "backgroundThrottle": false
    }
  },
  "ios": {
    "allowsLinkPreview": false,
    "scrollEnabled": true
  }
}